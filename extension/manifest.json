{
  "manifest_version": 3,
  "name": "Privacy-Preserving Vision Agent",
  "version": "0.1.0",
  "description": "Reads the page locally, redacts PII on-device, and lets a server-side LLM drive click/type/scroll actions on sanitised state only.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Privacy Vision Agent"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/element-registry.js",
        "lib/pii-patterns.js",
        "lib/pii-detector.js",
        "lib/tokenizer.js",
        "lib/dom-extractor.js",
        "lib/executor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/tesseract/*",
        "vendor/tfjs/*",
        "models/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {}
}