# Copy this file to .env and fill in your key. Never commit .env.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional alternative providers (Phase 2+)
GEMINI_API_KEY=
OPENAI_API_KEY=

HOST=0.0.0.0
PORT=8000

# Set to 1 to append every /agent/step request this server receives to
# eval/network-payload.jsonl — used to prove no raw PII crosses the wire.
# Leave unset for normal use.
PVA_LOG_PAYLOADS=
